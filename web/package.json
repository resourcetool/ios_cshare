{
  "name": "cshare-web",
  "version": "1.0.0",
  "private": true,
  "description": "CSHARE for iPhone: the Android app's own source, built for the web as an installable PWA",
  "scripts": {
    "prepare:src": "node scripts/prepare.mjs",
    "build": "npm run prepare:src && vite build && node scripts/finish-build.mjs",
    "preview": "vite preview",
    "test": "npm run prepare:src && vitest run"
  },
  "dependencies": {
    "@fontsource/noto-sans-math": "^5.0.8",
    "@fontsource/noto-sans-symbols": "^5.0.8",
    "@fontsource/noto-sans-symbols-2": "^5.0.8",
    "@fontsource/roboto": "^5.0.8",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "firebase": "^10.14.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-screens": "^4.4.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
